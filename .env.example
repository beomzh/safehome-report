# 공공데이터포털 API 키 (사용자 각자 발급, 이미지·저장소에 포함 금지)
PUBLIC_DATA_API_KEY=

# LLM 연동 (선택). none | openai-compatible | ollama | anthropic
LLM_PROVIDER=none
# LLM 엔드포인트/키. openai-compatible: BASE_URL 은 …/responses 또는 …/chat/completions 전체 주소. 실제 값은 로컬 .env 에만 넣는다
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000

# 로그 레벨: debug | info | warn | error (기본 info). 로그에는 성명·금액·매물 텍스트·키를 남기지 않는다
LOG_LEVEL=info
